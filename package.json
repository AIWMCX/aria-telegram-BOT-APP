{
  "name": "aria-terminal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Trial signup, Ed25519 licensing, and Stripe payments backend for the ARIA Sniper Telegram app.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx scripts/generate-keys.ts",
    "test:reality": "tsx test/product-reality.ts",
    "test:backend": "tsx test/e2e.ts",
    "test:engine-contract": "tsx engine/src/contracts.test.ts",
    "test:engine-config": "tsx engine/src/config.test.ts",
    "test:engine-store": "tsx test/engine-store.ts",
    "test:engine-api": "tsx test/engine-api.ts",
    "test:engine-rpc": "tsx engine/src/rpc.test.ts",
    "test:engine-paper": "tsx engine/src/paper.test.ts && tsx engine/src/safety.test.ts",
    "test:engine-loop": "tsx engine/src/control-loop.test.ts",
    "test:frontend": "tsx test/frontend-reality.ts",
    "test:real1-smoke": "tsx test/real1-smoke.ts",
    "scan:real1": "tsx scripts/scan-real1-secrets.ts",
    "typecheck:engine": "tsc --noEmit -p engine/tsconfig.json",
    "test": "npm run test:reality && npm run test:backend"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "grammy": "^1.31.0",
    "hono": "^4.6.14",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "resend": "^4.0.1",
    "stripe": "^17.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
