# Copy to .env for local development. Never commit a real .env file.

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAplaceholder-do-not-commit-real-token
ADMIN_TELEGRAM_CHAT_ID=
PUBLIC_URL=https://your-project.up.railway.app

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_placeholder
ADMIN_EMAIL=you@example.com
FROM_EMAIL=onboarding@resend.dev

# ── License signing — run `npm run keygen` and paste its output here ────────
ARIA_LICENSE_PRIVATE_D=
ARIA_LICENSE_PUBLIC_X=

# ── Stripe (optional — trial tier works without it) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ── $rypto$ community redirect (optional) ────────────────────────────────
# DO NOT set this until the $rypto$-Telegram / AIWMC entity separation is
# confirmed complete — see CLAUDE.md "Stripe setup" section.
RYPTO_CHANNEL_URL=

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
DB_PATH=./data/aria.db

# ── Postgres (optional — new funded-account domain only, see
# docs/ARIA_FUNDS_ARCHITECTURE_V1.md. Leave blank locally unless you're
# working on users/wallet_accounts/ledger code) ─────────────────────────────
DATABASE_URL=

# Product reality - presentation truth only. These values never authorize
# funds, trading, signing, or withdrawals. Unsupported live/execution modes
# fail startup until corresponding code-backed capabilities exist.
ARIA_PRODUCT_ENVIRONMENT=production
ARIA_NETWORK_MODE=offline
ARIA_DATA_MODE=simulated
ARIA_EXECUTION_MODE=disabled
ARIA_CONTROL_STATE=stopped

# Local ARIA Engine only (never paste private keys, seed phrases, or wallet
# files here; these values belong on the customer's computer, not Railway).
# ARIA_ENGINE_API_URL=https://your-project.up.railway.app
# ARIA_ENGINE_RPC_URL=https://api.devnet.solana.com
# ARIA_ENGINE_WALLET_REF=os-keystore://aria/default
# ARIA_ENGINE_LICENSE=ARIA1.<local-license-token>
# ARIA_ENGINE_NETWORK=solana-devnet
# ARIA_ENGINE_MODE=paper
# ARIA_ENGINE_VERSION=0.1.0
