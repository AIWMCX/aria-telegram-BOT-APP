# Copy to .env for local development. Never commit a real .env file.

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAplaceholder-do-not-commit-real-token
ADMIN_TELEGRAM_CHAT_ID=
PUBLIC_URL=https://your-project.up.railway.app

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_placeholder
ADMIN_EMAIL=you@example.com
FROM_EMAIL=onboarding@resend.dev

# ── License signing — run `npm run keygen` and paste its output here ────────
ARIA_LICENSE_PRIVATE_D=
ARIA_LICENSE_PUBLIC_X=

# ── ARIAE1 entitlement signing (optional — gates real entitlement issuance
# at /api/engine/pair; pairing still works without it, just returns no
# token). A DIFFERENT keypair from ARIA_LICENSE_PRIVATE_D/_X above — never
# share signing keys across token formats. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ed25519');console.log('ARIA_ENTITLEMENT_PRIVATE_D='+privateKey.export({format:'jwk'}).d);console.log('ARIA_ENTITLEMENT_PUBLIC_X='+publicKey.export({format:'jwk'}).x)"
# The private half must never leave this service. The public half gets
# baked into aria-engine as a constant (src/entitlement-public-key.ts) —
# if you rotate this keypair, update that constant and cut a new engine
# release, or already-paired devices will fail to verify new tokens.
ARIA_ENTITLEMENT_PRIVATE_D=
ARIA_ENTITLEMENT_PUBLIC_X=

# ── Stripe (optional — trial tier works without it) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ── $rypto$ community redirect (optional) ────────────────────────────────
# DO NOT set this until the $rypto$-Telegram / AIWMC entity separation is
# confirmed complete — see CLAUDE.md "Stripe setup" section.
RYPTO_CHANNEL_URL=

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
DB_PATH=./data/aria.db

# ── Postgres (optional — new funded-account domain only, see
# docs/ARIA_FUNDS_ARCHITECTURE_V1.md. Leave blank locally unless you're
# working on users/wallet_accounts/ledger code) ─────────────────────────────
DATABASE_URL=
