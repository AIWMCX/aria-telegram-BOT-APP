# ARIA control plane - environment template. NAMES AND COMMENTS ONLY.
# Copy to deploy/.env (chmod 600) and fill in on the host. NEVER commit .env.
# Lines starting with # are ignored. Leave optional vars empty/commented if unused.
# Do not wrap values in quotes and do not put spaces around "=".

# ============ MUST BE COPIED UNCHANGED FROM THE OLD RAILWAY DASHBOARD ============
# Regenerating any of these four invalidates EVERY license / entitlement already
# issued to customers and engines. Copy the values from Railway -> service ->
# Variables (do not run `npm run keygen`). If Railway is gone and you no longer
# have them, existing tokens cannot be re-validated: you would have to re-issue.
ARIA_LICENSE_PRIVATE_D=
ARIA_LICENSE_PUBLIC_X=
ARIA_ENTITLEMENT_PRIVATE_D=
ARIA_ENTITLEMENT_PUBLIC_X=

# ============ NEW AT CUTOVER (generate fresh) ============
# MUST be freshly generated: the old secret leaked into Railway logs (2026-09-26 audit).
# Generate with:  openssl rand -hex 32     (min 16 chars; letters/digits/_/- only)
TELEGRAM_WEBHOOK_SECRET=
# Password for the bundled Postgres container. Generate:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ============ TELEGRAM ============
# Same bot token as before (from @BotFather). Reuse it only if you have not
# revoked it; if you rotate it in BotFather, put the new one here.
TELEGRAM_BOT_TOKEN=
# Chat id that receives admin alerts (optional).
ADMIN_TELEGRAM_CHAT_ID=
# Full public https:// URL Telegram can reach, NO trailing slash, e.g.
# https://aria.example.com. The app registers PUBLIC_URL + /api/telegram/webhook
# with Telegram on boot and re-checks it periodically (self-healing).
# It is also what the BotFather Mini App menu button should point at.
PUBLIC_URL=
# "webhook" for production (requires TELEGRAM_WEBHOOK_SECRET; app refuses to boot
# otherwise). "polling" = long polling, only for local testing; never run polling
# and a webhook on the same bot token at the same time.
TELEGRAM_TRANSPORT=webhook

# ============ EMAIL (Resend) ============
RESEND_API_KEY=
ADMIN_EMAIL=
FROM_EMAIL=

# ============ STRIPE (optional; paid checkout disabled unless both secrets set) ============
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ============ COMMUNITY (optional) ============
RYPTO_CHANNEL_URL=

# ============ SERVER (usually leave default) ============
LOG_LEVEL=info
# PORT, DB_PATH and DATABASE_URL are set by docker-compose.yml itself; do not set here.

# ============ OPTIONAL: Cloudflare Tunnel (compose profile "tunnel") ============
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ============ OPTIONAL: build identity shown in /healthz ============
# Better exported in the shell before `docker compose up --build`:
#   export GIT_SHA=$(git rev-parse HEAD); export GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
# GIT_SHA=
# GIT_BRANCH=

# ============ DO NOT SET on a normal host (one-shot diagnostics, see src/config.ts) ============
# RUN_LEDGER_SELFTEST, RUN_ENGINE_CONTROL_SELFTEST, RUN_ENGINE_AUTH_SELFTEST,
# RUN_ENGINE_SYNC_SELFTEST, RUN_SYNC_DESYNC_REPRO
